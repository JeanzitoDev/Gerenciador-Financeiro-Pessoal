{
  "name": "meu-norte",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run tests/finance.test.ts",
    "test:db": "vitest run tests/database.test.ts",
    "check": "npm run test && npm run typecheck && npm run build",
    "format": "prettier --write src tests scripts docs README.md next.config.ts vitest.config.ts tsconfig.json package.json postcss.config.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.99.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
