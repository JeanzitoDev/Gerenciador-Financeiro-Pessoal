NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Fase 2: cadastro com e-mail/senha sem confirmação nem recuperação por e-mail.
# Desative Confirm Email no Supabase. Defina senha mínima 8 no painel também.
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=false

# Origem exata do navegador. Em desenvolvimento use http://localhost:3000.
# Na Vercel use https://meunorte-financeiro.vercel.app (sem /app).
APP_ORIGIN=http://localhost:3000

# Necessária SOMENTE para habilitar "Apagar minha conta".
# Chave privada sb_secret_... do MESMO projeto Supabase (ou service_role legado).
# Configure no .env.local / Vercel Environment Variables. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
